def validate_date(value, parent=None):
    if not value:
        return True
    try:
        datetime.strptime(value, "%Y-%m-%d")
        return True
    except ValueError:
        messagebox.showwarning("Invalid date", "Use YYYY-MM-DD, for example 2026-10-25.", parent=parent or root)
        return False


def get_selected_task():
    selected = task_tree.selection()
    if not selected:
        messagebox.showwarning("Select task", "Choose a task from the list first.")
        return None
    task_id = int(selected[0])
    return next((t for t in get_tasks() if t["id"] == task_id), None)


def get_tasks():
    rows = db.execute("SELECT id, name, done, deadline, priority FROM tasks ORDER BY id DESC").fetchall()
    return [{"id": r[0], "name": r[1], "done": bool(r[2]), "deadline": r[3] or "", "priority": r[4] or "Sedang"} for r in rows]


def add_task():
    name = task_name_entry.get().strip()
    deadline = task_deadline_entry.get().strip()
    priority = task_priority_var.get()
    if not name:
        messagebox.showwarning("Missing task", "Enter a task name.")
        return
    if not validate_date(deadline):
        return
    db.execute("INSERT INTO tasks(name, done, deadline, priority) VALUES(?, 0, ?, ?)", (name, deadline or None, priority))
    db.commit()
    task_name_entry.delete(0, tk.END)
    refresh_tasks()


def refresh_tasks():
    for item in task_tree.get_children():
        task_tree.delete(item)
    keyword = task_search_var.get().strip().lower()
    status_filter = task_filter_var.get()
    for t in get_tasks():
        if keyword not in t["name"].lower():
            continue
        if status_filter == "Belum selesai" and t["done"]:
            continue
        if status_filter == "Selesai" and not t["done"]:
            continue
        status = "Selesai" if t["done"] else "Belum selesai"
        task_tree.insert("", tk.END, iid=str(t["id"]), values=(t["name"], t["deadline"] or "-", t["priority"], status), tags=("done" if t["done"] else t["priority"],))
    update_dashboard()


def toggle_task():
    t = get_selected_task()
    if t:
        db.execute("UPDATE tasks SET done=? WHERE id=?", (0 if t["done"] else 1, t["id"]))
        db.commit()
        refresh_tasks()


def delete_task():
    t = get_selected_task()
    if t and messagebox.askyesno("Delete task", f"Delete '{t['name']}'?"):
        db.execute("DELETE FROM tasks WHERE id=?", (t["id"],))
        db.commit()
        refresh_tasks()


def edit_task():
    t = get_selected_task()
    if not t:
        return
    win = tk.Toplevel(root)
    win.title("Edit Task")
    win.geometry("390x310")
    win.configure(bg=BG)
    win.transient(root)
    win.grab_set()
    make_label(win, "Edit Task", 17, True, TEXT, BG).pack(anchor="w", padx=18, pady=(16, 10))
    make_label(win, "Task name", 10, False, TEXT, BG).pack(anchor="w", padx=18)
    name = tk.Entry(win, font=("Segoe UI", 10))
    name.pack(fill="x", padx=18, pady=(4, 10))
    name.insert(0, t["name"])
    make_label(win, "Deadline (YYYY-MM-DD)", 10, False, TEXT, BG).pack(anchor="w", padx=18)
    deadline = tk.Entry(win, font=("Segoe UI", 10))
    deadline.pack(fill="x", padx=18, pady=(4, 10))
    deadline.insert(0, t["deadline"])
    make_label(win, "Priority", 10, False, TEXT, BG).pack(anchor="w", padx=18)
    priority = tk.StringVar(value=t["priority"])
    ttk.Combobox(win, textvariable=priority, values=["Tinggi", "Sedang", "Rendah"], state="readonly").pack(fill="x", padx=18, pady=(4, 12))

    def save():
        new_name, new_deadline = name.get().strip(), deadline.get().strip()
        if not new_name:
            messagebox.showwarning("Missing name", "Task name cannot be empty.", parent=win)
            return
        if not validate_date(new_deadline, win):
            return
        db.execute("UPDATE tasks SET name=?, deadline=?, priority=? WHERE id=?", (new_name, new_deadline or None, priority.get(), t["id"]))
        db.commit()
        win.destroy()
        refresh_tasks()

    make_button(win, "Save Changes", save).pack(pady=4)


make_button(task_actions, "Mark Complete / Undo", toggle_task, GREEN).pack(side="left", padx=(0, 7))
make_button(task_actions, "Edit Task", edit_task).pack(side="left", padx=(0, 7))
make_button(task_actions, "Delete Task", delete_task, RED).pack(side="left")
task_search_var.trace_add("write", lambda *_: refresh_tasks())
task_filter_var.trace_add("write", lambda *_: refresh_tasks())
task_name_entry.bind("<Return>", lambda e: add_task())

