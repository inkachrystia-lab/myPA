BG = "#F4F6FA"
SIDEBAR = "#202B46"
ACCENT = "#6C63FF"
TEXT = "#202B46"
MUTED = "#68738A"
WHITE = "#FFFFFF"
GREEN = "#16A085"
RED = "#E74C3C"
ORANGE = "#E67E22"

BASE_DIR = Path(__file__).resolve().parent
DB_PATH = BASE_DIR / "mypa.db"

db = sqlite3.connect(str(DB_PATH))
db.execute("PRAGMA foreign_keys = ON")
cur = db.cursor()

# Create tables, keeping existing tasks intact.
cur.execute("""
CREATE TABLE IF NOT EXISTS tasks (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    done INTEGER NOT NULL DEFAULT 0
)
""")
cur.execute("PRAGMA table_info(tasks)")
task_columns = [r[1] for r in cur.fetchall()]
if "deadline" not in task_columns:
    cur.execute("ALTER TABLE tasks ADD COLUMN deadline TEXT")
if "priority" not in task_columns:
    cur.execute("ALTER TABLE tasks ADD COLUMN priority TEXT DEFAULT 'Sedang'")

cur.execute("""
CREATE TABLE IF NOT EXISTS events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    event_date TEXT NOT NULL,
    title TEXT NOT NULL,
    details TEXT DEFAULT ''
)
""")
cur.execute("""
CREATE TABLE IF NOT EXISTS notes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT DEFAULT '',
    updated_at TEXT NOT NULL
)
""")
cur.execute("""
CREATE TABLE IF NOT EXISTS settings (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
)
""")
db.commit()


def setting_get(key, default=""):
    row = db.execute("SELECT value FROM settings WHERE key=?", (key,)).fetchone()
    return row[0] if row else default


def setting_set(key, value):
    db.execute(
        "INSERT INTO settings(key, value) VALUES(?, ?) "
        "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
        (key, str(value))
    )
    db.commit()


