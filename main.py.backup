def dashboard_card(parent, title, color):
    box = panel(parent)
    box.pack(side="left", fill="x", expand=True, padx=(0, 10))
    make_label(box, title, 10, False, MUTED, WHITE).pack(anchor="w", padx=15, pady=(15, 5))
    value = make_label(box, "0", 24, True, color, WHITE)
    value.pack(anchor="w", padx=15, pady=(0, 15))
    return value


