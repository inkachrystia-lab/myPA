def change_month(amount):
    global calendar_year, calendar_month
    calendar_month += amount
    if calendar_month > 12:
        calendar_month = 1
        calendar_year += 1
    elif calendar_month < 1:
        calendar_month = 12
        calendar_year -= 1
    render_calendar()


def go_today():
    global calendar_year, calendar_month, selected_calendar_date
    selected_calendar_date = date.today()
    calendar_year, calendar_month = date.today().year, date.today().month
    render_calendar()


def select_calendar_date(day):
    global selected_calendar_date
    selected_calendar_date = date(calendar_year, calendar_month, day)
    render_calendar()


def render_calendar():
    for widget in calendar_grid.winfo_children():
        widget.destroy()
    calendar_heading.config(text=f"{cal.month_name[calendar_month]} {calendar_year}")
    selected_date_label.config(text=selected_calendar_date.strftime("%d %B %Y"))
    for col, day_name in enumerate(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]):
        make_label(calendar_grid, day_name, 9, True, MUTED, WHITE, width=8).grid(row=0, column=col, padx=2, pady=3)
    month = cal.monthcalendar(calendar_year, calendar_month)
    for r, week in enumerate(month, start=1):
        for c, day in enumerate(week):
            if day == 0:
                tk.Label(calendar_grid, text="", bg=WHITE, width=8, height=2).grid(row=r, column=c, padx=2, pady=2)
                continue
            day_date = date(calendar_year, calendar_month, day)
            has_event = db.execute("SELECT 1 FROM events WHERE event_date=? LIMIT 1", (day_date.isoformat(),)).fetchone()
            label = f"{day}\n•" if has_event else str(day)
            bg = ACCENT if day_date == selected_calendar_date else ("#E5F7F1" if day_date == date.today() else "#F4F6FA")
            fg = WHITE if day_date == selected_calendar_date else TEXT
            tk.Button(
                calendar_grid, text=label, width=8, height=2, bg=bg, fg=fg,
                relief="flat", cursor="hand2",
                command=lambda d=day: select_calendar_date(d)
            ).grid(row=r, column=c, padx=2, pady=2)
    refresh_event_list()


def refresh_event_list():
    event_list.delete(0, tk.END)
    rows = db.execute("SELECT id, title FROM events WHERE event_date=? ORDER BY id", (selected_calendar_date.isoformat(),)).fetchall()
    for event_id, title in rows:
        event_list.insert(tk.END, f"{event_id} | {title}")
    if not rows:
        event_list.insert(tk.END, "No events for this date.")


def add_event():
    title = event_title_entry.get().strip()
    if not title:
        messagebox.showwarning("Missing event", "Enter an event title.")
        return
    db.execute("INSERT INTO events(event_date, title) VALUES(?, ?)", (selected_calendar_date.isoformat(), title))
    db.commit()
    event_title_entry.delete(0, tk.END)
    render_calendar()
    update_dashboard()


def delete_event():
    selected = event_list.curselection()
    if not selected:
        messagebox.showwarning("Select event", "Select an event to delete.")
        return
    text = event_list.get(selected[0])
    if "|" not in text:
        return
    event_id = int(text.split("|", 1)[0].strip())
    if messagebox.askyesno("Delete event", "Delete the selected event?"):
        db.execute("DELETE FROM events WHERE id=?", (event_id,))
        db.commit()
        render_calendar()
        update_dashboard()


