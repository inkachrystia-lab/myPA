def make_button(parent, text, command, bg=ACCENT, fg=WHITE, **kwargs):
    return tk.Button(
        parent, text=text, command=command, bg=bg, fg=fg,
        activebackground=bg, activeforeground=fg,
        relief="flat", bd=0, padx=12, pady=8,
        font=("Segoe UI", 9, "bold"), cursor="hand2", **kwargs
    )


def make_label(parent, text, size=10, bold=False, color=TEXT, bg=None, **kwargs):
    return tk.Label(
        parent, text=text,
        font=("Segoe UI", size, "bold" if bold else "normal"),
        fg=color, bg=bg or BG, **kwargs
    )


def panel(parent, **kwargs):
    return tk.Frame(
        parent, bg=WHITE, highlightbackground="#E1E5EF",
        highlightthickness=1, **kwargs
    )


