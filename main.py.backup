pages = {}


def register_page(name):
    frame = tk.Frame(page_host, bg=BG)
    pages[name] = frame
    return frame


def show_page(name):
    global current_page
    current_page = name
    for frame in pages.values():
        frame.pack_forget()
    pages[name].pack(fill="both", expand=True)
    page_title.config(text=name)
    if name == "Dashboard":
        update_dashboard()
    elif name == "Tasks":
        refresh_tasks()
    elif name == "Calendar":
        render_calendar()
    elif name == "Notes":
        refresh_notes()
    elif name == "Settings":
        load_settings_page()


