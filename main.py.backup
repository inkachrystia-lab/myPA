def refresh_notes():
    global note_ids
    note_search = note_search_var.get().strip().lower()
    notes_list.delete(0, tk.END)
    note_ids = []
    rows = db.execute("SELECT id, title, content FROM notes ORDER BY updated_at DESC, id DESC").fetchall()
    for note_id, title, content in rows:
        if note_search and note_search not in (title + " " + (content or "")).lower():
            continue
        note_ids.append(note_id)
        notes_list.insert(tk.END, title or "(Untitled)")
    if selected_note_id in note_ids:
        idx = note_ids.index(selected_note_id)
        notes_list.selection_set(idx)


def on_note_select(event=None):
    global selected_note_id
    selection = notes_list.curselection()
    if not selection:
        return
    selected_note_id = note_ids[selection[0]]
    row = db.execute("SELECT title, content FROM notes WHERE id=?", (selected_note_id,)).fetchone()
    if row:
        note_title_entry.delete(0, tk.END)
        note_title_entry.insert(0, row[0])
        note_content.delete("1.0", tk.END)
        note_content.insert("1.0", row[1] or "")


def new_note():
    global selected_note_id
    selected_note_id = None
    notes_list.selection_clear(0, tk.END)
    note_title_entry.delete(0, tk.END)
    note_content.delete("1.0", tk.END)
    note_title_entry.focus_set()


def save_note():
    global selected_note_id
    title = note_title_entry.get().strip()
    content = note_content.get("1.0", "end-1c").strip()
    if not title:
        messagebox.showwarning("Missing title", "Give your note a title.")
        return
    now = datetime.now().isoformat(timespec="seconds")
    if selected_note_id is None:
        cur = db.execute("INSERT INTO notes(title, content, updated_at) VALUES(?, ?, ?)", (title, content, now))
        selected_note_id = cur.lastrowid
    else:
        db.execute("UPDATE notes SET title=?, content=?, updated_at=? WHERE id=?", (title, content, now, selected_note_id))
    db.commit()
    refresh_notes()
    messagebox.showinfo("Saved", "Your note has been saved.")


def delete_note():
    global selected_note_id
    if selected_note_id is None:
        messagebox.showwarning("Select note", "Choose a note first.")
        return
    if messagebox.askyesno("Delete note", "Delete this note permanently?"):
        db.execute("DELETE FROM notes WHERE id=?", (selected_note_id,))
        db.commit()
        selected_note_id = None
        new_note()
        refresh_notes()


notes_list.bind("<<ListboxSelect>>", on_note_select)
note_search_var.trace_add("write", lambda *_: refresh_notes())

# =============================== AI Assistant ===============================

ai_page = register_page("AI Assistant")
make_label(ai_page, "MYPA Assistant", 18, True, TEXT, BG).pack(anchor="w", pady=(0, 5))
make_label(ai_page, "This starter assistant works locally using simple rules; it is not connected to an online AI model.", 9, False, MUTED, BG, wraplength=800, justify="left").pack(anchor="w", pady=(0, 12))

chat_panel = panel(ai_page)
chat_panel.pack(fill="both", expand=True)
chat_log = tk.Text(chat_panel, wrap="word", font=("Segoe UI", 10), bg=WHITE, fg=TEXT, bd=0, state="disabled")
chat_log.pack(fill="both", expand=True, padx=12, pady=12)
chat_log.tag_configure("user", foreground=ACCENT, font=("Segoe UI", 10, "bold"))
chat_log.tag_configure("assistant", foreground=GREEN, font=("Segoe UI", 10, "bold"))

chat_bottom = tk.Frame(ai_page, bg=BG)
chat_bottom.pack(fill="x", pady=(10, 0))
chat_input = tk.Entry(chat_bottom, font=("Segoe UI", 11))
chat_input.pack(side="left", fill="x", expand=True, ipady=8, padx=(0, 8))
make_button(chat_bottom, "Send", lambda: send_chat()).pack(side="right")


def append_chat(sender, message, tag):
    chat_log.configure(state="normal")
    chat_log.insert(tk.END, sender + ": ", tag)
    chat_log.insert(tk.END, message + "\n\n")
    chat_log.configure(state="disabled")
    chat_log.see(tk.END)


def assistant_reply(message):
    text = message.lower()
    if any(word in text for word in ["halo", "hai", "hello", "hi"]):
        return "Halo! Aku MYPA Assistant. Kamu bisa bertanya tentang tugas, deadline, atau cara memakai MYPA."
    if "tugas" in text or "task" in text:
        rows = db.execute("SELECT name, done, deadline, priority FROM tasks ORDER BY done, deadline").fetchall()
        if not rows:
            return "Belum ada tugas tersimpan. Buka menu Tasks untuk menambahkan tugas."
        lines = []
        for name, done, deadline, priority in rows[:8]:
            state = "Selesai" if done else "Belum selesai"
            due = deadline or "tanpa deadline"
            lines.append(f"• {name} — {state}; deadline: {due}; prioritas: {priority or 'Sedang'}")
        return "Berikut ringkasan tugasmu:\n" + "\n".join(lines)
    if "jadwal" in text or "kalender" in text or "calendar" in text:
        rows = db.execute("SELECT event_date, title FROM events WHERE event_date >= ? ORDER BY event_date LIMIT 8", (date.today().isoformat(),)).fetchall()
        if not rows:
            return "Belum ada kegiatan mendatang di Calendar. Tambahkan kegiatan melalui menu Calendar."
        return "Kegiatan mendatang:\n" + "\n".join(f"• {d}: {title}" for d, title in rows)
    if "catatan" in text or "notes" in text:
        rows = db.execute("SELECT title FROM notes ORDER BY updated_at DESC LIMIT 8").fetchall()
        return "Catatan tersimpan:\n" + ("\n".join(f"• {r[0]}" for r in rows) if rows else "Belum ada catatan. Kamu bisa membuatnya di menu Notes.")
    if "prioritas" in text or "mulai" in text or "sibuk" in text:
        row = db.execute("SELECT name, deadline, priority FROM tasks WHERE done=0 ORDER BY CASE priority WHEN 'Tinggi' THEN 1 WHEN 'Sedang' THEN 2 ELSE 3 END, deadline LIMIT 1").fetchone()
        if row:
            return f"Coba mulai dari '{row[0]}'. Prioritasnya {row[2] or 'Sedang'} dan deadline-nya {row[1] or 'belum ditentukan'}. Pecah tugas besar menjadi langkah kecil."
        return "Tidak ada tugas aktif saat ini. Tambahkan tugas baru agar kita bisa menyusun prioritas."
    if "bantu" in text or "help" in text:
        return "Aku bisa merangkum tugas, melihat kegiatan kalender, menunjukkan catatan, atau memberi saran sederhana untuk memulai tugas. Coba tulis: 'Apa tugasku?'"
    return "Aku masih menggunakan respons lokal sederhana. Coba tanyakan tentang tugas, kalender, catatan, prioritas, atau ketik 'bantu'. AI online bisa diintegrasikan nanti dengan API dan koneksi internet."


def send_chat(event=None):
    message = chat_input.get().strip()
    if not message:
        return
    chat_input.delete(0, tk.END)
    append_chat("Kamu", message, "user")
    append_chat("MYPA", assistant_reply(message), "assistant")


chat_input.bind("<Return>", send_chat)
append_chat("MYPA", "Halo! Aku MYPA Assistant. Ketik 'bantu' untuk melihat apa yang bisa kulakukan.", "assistant")

# =============================== Settings ===============================

settings_page = register_page("Settings")
make_label(settings_page, "Personalize your MYPA experience.", 10, False, MUTED, BG).pack(anchor="w", pady=(0, 12))
settings_panel = panel(settings_page)
settings_panel.pack(fill="x")
make_label(settings_panel, "Preferences", 15, True, TEXT, WHITE).pack(anchor="w", padx=18, pady=(18, 12))

make_label(settings_panel, "Your name", 10, True, TEXT, WHITE).pack(anchor="w", padx=18)
username_entry = tk.Entry(settings_panel, font=("Segoe UI", 11))
username_entry.pack(fill="x", padx=18, pady=(5, 14), ipady=5)

make_label(settings_panel, "Theme", 10, True, TEXT, WHITE).pack(anchor="w", padx=18)
theme_var = tk.StringVar(value=setting_get("theme", "Light"))
theme_combo = ttk.Combobox(settings_panel, textvariable=theme_var, values=["Light", "Dark"], state="readonly", width=18)
theme_combo.pack(anchor="w", padx=18, pady=(5, 14))

settings_status = make_label(settings_panel, "", 9, False, GREEN, WHITE)
settings_status.pack(anchor="w", padx=18, pady=(0, 8))
make_button(settings_panel, "Save Settings", lambda: save_settings()).pack(anchor="w", padx=18, pady=(0, 18))


def load_settings_page():
    username_entry.delete(0, tk.END)
    username_entry.insert(0, setting_get("username", ""))
    theme_var.set(setting_get("theme", "Light"))


def save_settings():
    username = username_entry.get().strip() or "there"
    theme = theme_var.get()
    setting_set("username", username)
    setting_set("theme", theme)
    settings_status.config(text="Settings saved. Restart MYPA to apply the theme selection.")
    dashboard_welcome = f"Welcome, {username}!"
    # Update dashboard welcome label if it exists.
    for widget in dashboard_page.winfo_children():
        if isinstance(widget, tk.Label) and str(widget.cget("text")).startswith("Welcome,"):
            widget.config(text=dashboard_welcome)
    messagebox.showinfo("Settings saved", "Your settings have been saved.")
    # Theme choice is saved; this version keeps the current color scheme until theme styling is expanded.


# =============================== Startup / shutdown ===============================

def close_app():
    try:
        db.commit()
        db.close()
    finally:
        root.destroy()


root.protocol("WM_DELETE_WINDOW", close_app)
show_page("Dashboard")
root.mainloop()
