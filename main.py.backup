completed_value = dashboard_card(cards, "Completed", GREEN)
remaining_value = dashboard_card(cards, "Remaining", RED)

dash_bottom = tk.Frame(dashboard_page, bg=BG)
dash_bottom.pack(fill="both", expand=True, pady=(20, 0))

today_panel = panel(dash_bottom)
today_panel.pack(fill="both", expand=True)
make_label(today_panel, "Today's Overview", 15, True, TEXT, WHITE).pack(anchor="w", padx=18, pady=(16, 8))
today_text = tk.Text(today_panel, height=8, wrap="word", font=("Segoe UI", 11), bd=0, bg=WHITE, fg=MUTED)
today_text.pack(fill="both", expand=True, padx=18, pady=(0, 12))
today_text.configure(state="disabled")


def update_dashboard():
    rows = db.execute("SELECT done, deadline, name FROM tasks").fetchall()
    total = len(rows)
    completed = sum(1 for r in rows if r[0])
    total_value.config(text=str(total))
    completed_value.config(text=str(completed))
    remaining_value.config(text=str(total - completed))

    today = date.today().isoformat()
    due_today = [r[2] for r in rows if not r[0] and r[1] == today]
    upcoming = db.execute(
        "SELECT title FROM events WHERE event_date=? ORDER BY id", (today,)
    ).fetchall()
    lines = [f"Today: {date.today().strftime('%d %B %Y')}", ""]
    lines.append("Tasks due today:")
    lines.extend([f"• {x}" for x in due_today] or ["• No tasks due today."])
    lines += ["", "Calendar events today:"]
    lines.extend([f"• {x[0]}" for x in upcoming] or ["• No events scheduled."])
    today_text.configure(state="normal")
    today_text.delete("1.0", tk.END)
    today_text.insert("1.0", "\n".join(lines))
    today_text.configure(state="disabled")


